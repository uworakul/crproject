# Copy to .env and fill in real values. Never commit the real .env file.
DATABASE_URL="sqlserver://HOST:1433;database=DBNAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Google Cloud Service Account JSON key (whole file contents, one line) — used
# to upload employee/ID card photos to the shared Google Drive folder set in
# System Configuration ("File Folder"). Create it in Google Cloud Console:
# IAM & Admin -> Service Accounts -> Create -> Keys -> Add Key -> JSON, then
# share the target Drive folder with that service account's email (Editor).
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","client_email":"...","private_key":"..."}'
