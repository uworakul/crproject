# Copy to .env and fill in real values. Never commit the real .env file.
# NOTE: at runtime the app no longer connects using this value directly —
# each request resolves its own tenant database from tenants.json (see
# tenants.example.json). DATABASE_URL here is only used by the Prisma CLI
# itself (schema diff/migrate/seed during development) and should point at
# whichever tenant DB you're actively developing against.
DATABASE_URL="sqlserver://HOST:1433;database=DBNAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Cloudflare R2 (S3-compatible object storage) — used to upload employee/ID
# card photos. Create in the Cloudflare dashboard: R2 -> Create bucket, then
# R2 -> Manage API Tokens -> Create API Token (permissions: Object Read &
# Write, scoped to that bucket) to get the Access Key ID/Secret Access Key.
# R2_ACCOUNT_ID is your Cloudflare account ID (shown on the R2 overview page).
R2_ACCOUNT_ID="REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="REPLACE_WITH_BUCKET_NAME"
