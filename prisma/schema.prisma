model InvEmployeeDebt {
  DebtID          Int       @id(map: "PK_inv_employee_debt") @default(autoincrement())
  EmpCode         String    @db.VarChar(15)
  // Nullable as of 2026-09-19 — originally every debt row came from an
  // inventory ISSUE confirm. Now "รายการหักต่องวด" on the employee page can
  // also create a debt directly (loans, advances, etc. per
  // ref_deduction_type.IsInstallment) with no underlying stock movement, so
  // exactly one of MovementID / DeductionCode is set depending on origin —
  // enforced in application code, not a DB CHECK (no such constraint exists
  // in the approved DDL for this table to extend).
  MovementID      Int?
  DeductionCode   String?   @db.VarChar(10)
  // Set only for debts created by approving a Request (trn_request_header) —
  // lets the "รายการหักต่องวด" tab show the source document's เลขที่เอกสาร/
  // วันที่อนุมัติ. Null for MovementID-origin debts and for debts created
  // directly on this tab with no underlying document.
  RequestHeaderID Int?
  Description     String?   @db.NVarChar(200) // free-text note for manually-created (DeductionCode-origin) debts
  TotalAmount     Decimal   @default(0) @db.Decimal(12, 2)
  PaidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  RemainingAmount Decimal   @default(0) @db.Decimal(12, 2)
  DeductPerPeriod Decimal?  @db.Decimal(12, 2) // "ยอดหักต่องวด" — tracked here only, not yet auto-applied by Payroll Calculate
  Status          String    @default("OPEN") @db.VarChar(10) // CHECK: OPEN | CLOSED
  CreatedDate     DateTime? @default(now()) @db.DateTime
  CreatedBy       String?   @db.VarChar(20)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  Employee      MstEmployee       @relation(fields: [EmpCode], references: [EmpCode], map: "FK_inv_employee_debt_employee", onUpdate: NoAction, onDelete: NoAction)
  Movement      InvStockMovement? @relation(fields: [MovementID], references: [MovementID], map: "FK_inv_employee_debt_movement", onUpdate: NoAction, onDelete: NoAction)
  DeductionType RefDeductionType? @relation(fields: [DeductionCode], references: [DeductionCode], map: "FK_inv_employee_debt_deduction_type", onUpdate: NoAction, onDelete: NoAction)
  RequestHeader TrnRequestHeader? @relation(fields: [RequestHeaderID], references: [RequestHeaderID], map: "FK_inv_employee_debt_request_header", onUpdate: NoAction, onDelete: NoAction)

  @@map("inv_employee_debt")
}

