}

// ============================================================
// โมดูล 6: คำนวณและจ่ายเงินเดือน (Payroll)
// ============================================================
model TrnPayrollTransaction {
  TransactionID     Int       @id(map: "PK_trn_payroll_transaction") @default(autoincrement())
  EmpCode           String    @db.VarChar(15)
  PeriodID          Int
  SiteCode          String    @db.VarChar(10)
  WorkDays          Decimal   @default(0) @db.Decimal(5, 2)
  DoubleShiftDays   Decimal   @default(0) @db.Decimal(5, 2)
  HolidayDays       Decimal   @default(0) @db.Decimal(5, 2)
  OTHours           Decimal   @default(0) @db.Decimal(6, 2)
  OTAmount          Decimal   @default(0) @db.Decimal(10, 2)
  PositionAllowance Decimal   @default(0) @db.Decimal(10, 2)
  ShiftAllowance    Decimal   @default(0) @db.Decimal(10, 2)
  AdvanceDeduct     Decimal   @default(0) @db.Decimal(10, 2)
  LoanDeduct        Decimal   @default(0) @db.Decimal(10, 2)
  TrainingDeduct    Decimal   @default(0) @db.Decimal(10, 2)
  UniformDeduct     Decimal   @default(0) @db.Decimal(10, 2)
  GrossWage         Decimal   @default(0) @db.Decimal(12, 2)
  TaxWithheld       Decimal   @default(0) @db.Decimal(10, 2)
  SSOAmount         Decimal   @default(0) @db.Decimal(10, 2)
  // 2026-09-21 — computed by Calculate, same lifecycle as TaxWithheld/
  // SSOAmount (recomputed every run, zeroed by Cancel Calculate).
  // WelfareFundAmount = GrossWage x ref_welfare_fund.EmployeeRate for the
  // period's year (same base/shape as SSO, no min/max clamp — see
  // calculateWelfareFund() in src/lib/payroll.ts). InstallmentDeduct = sum
  // of this employee's OPEN inv_employee_debt rows (IsInstallment deduction
  // types only) at min(DeductPerPeriod, RemainingAmount) each — a live
  // PREVIEW recomputed fresh every Calculate run; Calculate never writes
  // back to inv_employee_debt.RemainingAmount itself (that only happens on
  // a future approval step, per the user — not built yet).
  WelfareFundAmount Decimal   @default(0) @db.Decimal(10, 2)
  InstallmentDeduct Decimal   @default(0) @db.Decimal(10, 2)
  OtherIncome       Decimal   @default(0) @db.Decimal(10, 2)
  OtherDeduction    Decimal   @default(0) @db.Decimal(10, 2)
  NetPay            Decimal   @default(0) @db.Decimal(12, 2)
  SourceWorksheetID Int?
  CreatedDate       DateTime  @default(now()) @db.DateTime
  CreatedBy         String?   @db.VarChar(20)
  UpdatedDate       DateTime? @db.DateTime
  UpdatedBy         String?   @db.VarChar(20)

  Employee        MstEmployee                  @relation(fields: [EmpCode], references: [EmpCode], map: "FK_trn_payroll_transaction_employee", onUpdate: NoAction, onDelete: NoAction)
  Period          SysPeriod                    @relation(fields: [PeriodID], references: [PeriodID], map: "FK_trn_payroll_transaction_period", onUpdate: NoAction, onDelete: NoAction)
  Site            MstSite                      @relation(fields: [SiteCode], references: [SiteCode], map: "FK_trn_payroll_transaction_site", onUpdate: NoAction, onDelete: NoAction)
  SourceWorksheet TrnWorksheetHeader?           @relation(fields: [SourceWorksheetID], references: [WorksheetID], map: "FK_trn_payroll_transaction_worksheet", onUpdate: NoAction, onDelete: NoAction)
  Details         TrnPayrollTransactionDetail[]

  @@unique([EmpCode, PeriodID], map: "UQ_trn_payroll_transaction")
  @@index([PeriodID, SiteCode], map: "IX_trn_payroll_transaction_Period_Site")
  @@map("trn_payroll_transaction")
}

// Itemized income/deduction lines per transaction (2026-09-21, "รายการประจำงวด")
// — additive alongside the flat columns above, NOT a replacement (kept them
// exactly as-is; still edited directly via PUT /api/payroll/transactions/[id]
// same as before — see CLAUDE.md for why). Code has no enforced FK: it's
// either an IncomeCode or a DeductionCode depending on LineType, i.e. two
// possible parent tables — same "free-text cross-reference, validated at the
// application layer" pattern already used elsewhere in this project (e.g.
// mst_employee.BlacklistCode). Description is a snapshot of the type's name
// at entry time (same rationale as Worksheet's DailyRate snapshot — survives
// the reference row being renamed/deleted later).
//
// Whenever a row here is added/edited/deleted, the parent transaction's
// OtherIncome (= sum of LineType=INCOME rows) / OtherDeduction (= sum of
// LineType=DEDUCTION rows) / NetPay are recomputed and written back — see
// recomputeTransactionOtherTotals() in src/lib/payroll.ts. Editing
// OtherIncome/OtherDeduction directly via the old endpoint still works, but
// the next detail-line change here will overwrite it (last write wins,
// documented in CLAUDE.md).
model TrnPayrollTransactionDetail {
  DetailID      Int       @id(map: "PK_trn_payroll_transaction_detail") @default(autoincrement())
  TransactionID Int
  LineType      String    @db.VarChar(10) // CHECK: INCOME | DEDUCTION
  Code          String    @db.VarChar(10) // ref_income_type.IncomeCode or ref_deduction_type.DeductionCode, per LineType
  Description   String    @db.NVarChar(100)
  // 2026-09-22 — which site (and position) this line's Days/Amount actually
  // came from, for employees who worked more than one site's Worksheet in
  // the same period (a SPARE covering a shift elsewhere). NULL for lines
  // added manually via "+ เพิ่มรายการ" (not tied to any Worksheet site) —
  // SQL Server's unique index treats every NULL as distinct, so multiple
  // manual lines never collide with each other on (TransactionID,LineType,
  // Code,SiteCode) the way pullPayrollFromWorksheet()'s per-site rows do.
  // PositionCode is informational only (not part of the unique key): within
  // one site's Worksheet an employee has exactly one position for the whole
  // month, so SiteCode alone is enough to keep pulled rows distinct.
  SiteCode      String?   @db.VarChar(10)
  PositionCode  String?   @db.VarChar(10)
  Hours         Decimal?  @db.Decimal(6, 2)
  Days          Decimal?  @db.Decimal(5, 2)
  Amount        Decimal   @db.Decimal(10, 2)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  Transaction TrnPayrollTransaction @relation(fields: [TransactionID], references: [TransactionID], map: "FK_trn_payroll_transaction_detail_transaction", onUpdate: NoAction, onDelete: NoAction)
  Site        MstSite?              @relation(fields: [SiteCode], references: [SiteCode], map: "FK_trn_payroll_transaction_detail_site", onUpdate: NoAction, onDelete: NoAction)
  Position    RefPosition?          @relation(fields: [PositionCode], references: [PositionCode], map: "FK_trn_payroll_transaction_detail_position", onUpdate: NoAction, onDelete: NoAction)

  @@unique([TransactionID, LineType, Code, SiteCode], map: "UQ_trn_payroll_transaction_detail")
  @@map("trn_payroll_transaction_detail")
}

model TrnPayrollCalculateLog {
  LogID          Int       @id(map: "PK_trn_payroll_calculate_log") @default(autoincrement())
  // Running number off ref_document_number code "PAYROLL" (2026-09-21,
  // "คำนวณเงินได้ประจำงวด" screen) — consumed once per Calculate run, not
  // per employee/transaction. Nullable: existing rows predate this field.
  DocumentNo     String?   @db.VarChar(20)
  PeriodID       Int
  EmployeeType   String    @db.VarChar(20)
  CalculatedBy   String    @db.VarChar(20)
  CalculatedDate DateTime  @default(now()) @db.DateTime
  Status         String    @db.VarChar(10) // CHECK: SUCCESS | CANCELLED
  EmployeeCount  Int       @default(0)
  TotalAmount    Decimal   @default(0) @db.Decimal(14, 2)
  CreatedDate    DateTime? @default(now()) @db.DateTime
  CreatedBy      String?   @db.VarChar(20)
  UpdatedDate    DateTime? @db.DateTime
  UpdatedBy      String?   @db.VarChar(20)

  Period     SysPeriod @relation(fields: [PeriodID], references: [PeriodID], map: "FK_trn_payroll_calculate_log_period", onUpdate: NoAction, onDelete: NoAction)
  Calculator SysUser   @relation(fields: [CalculatedBy], references: [UserID], map: "FK_trn_payroll_calculate_log_user", onUpdate: NoAction, onDelete: NoAction)

  @@map("trn_payroll_calculate_log")
}

model TrnPayrollLock {
  LockID      Int       @id(map: "PK_trn_payroll_lock") @default(autoincrement())
  PeriodID    Int
  IsLocked    Boolean   @default(false)
  LockedBy    String?   @db.VarChar(20)
  LockedDate  DateTime? @db.DateTime
  // 2026-09-24 — split "ส่งขออนุมัติ" (Lock, existing) from a genuine second
  // "อนุมัติ" (Approve) step per the user's explicit choice ("เพิ่มสถานะใหม่ 2
  // ขั้น: ส่งขออนุมัติ (Lock) → อนุมัติ (Approve) แยกกัน"). closePeriod() now
  // requires IsApproved as well as IsLocked. "ตีคืน" (renamed from
  // "ปลดล็อก") clears both back to false in one step — reversing an approved
  // period doesn't need a separate un-approve click first.
  IsApproved   Boolean   @default(false)
  ApprovedBy   String?   @db.VarChar(20)
  ApprovedDate DateTime? @db.DateTime
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  Period   SysPeriod @relation(fields: [PeriodID], references: [PeriodID], map: "FK_trn_payroll_lock_period", onUpdate: NoAction, onDelete: NoAction)
  Locker   SysUser?  @relation("PayrollLockLockedBy", fields: [LockedBy], references: [UserID], map: "FK_trn_payroll_lock_user", onUpdate: NoAction, onDelete: NoAction)
  Approver SysUser?  @relation("PayrollLockApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_trn_payroll_lock_approver", onUpdate: NoAction, onDelete: NoAction)

  @@map("trn_payroll_lock")
}

// ============================================================
// โมดูล 7: การลาและประวัติการลา (Leave)
// ============================================================
model MstLeaveType {
  LeaveTypeCode        String    @id(map: "PK_mst_leave_type") @db.VarChar(10)
  LeaveTypeName        String    @db.NVarChar(100)
  MaxDaysPerYear       Int       @db.TinyInt
  RequireMedicalCert   Boolean   @default(false)
  BasedOnTenure        Boolean   @default(false)
  // Company-wide entitlement cap (2026-09-21): MaxDaysPerYear is the same for
  // every employee of this type — no per-employee override anymore (see
  // MstEmployeeLeaveBalance.Entitled, which is no longer read as the source
  // of truth). null = every EmployeeType may request this leave type; a
  // value ("DAILY"/"MONTHLY", per EMPLOYEE_TYPE_VALUES) restricts it to only
  // that one — e.g. annual/vacation leave restricted to "MONTHLY".
  EligibleEmployeeType String?   @db.VarChar(20)
  // Which mst_employee date field "years of service" counts from when
  // BasedOnTenure=true — "START_DATE" or "PROBATION_PASS_DATE" (see
  // LEAVE_TENURE_COUNT_FROM_VALUES in src/lib/leave.ts). Meaningless (left
  // null) when BasedOnTenure=false.
  TenureCountFrom      String?   @db.VarChar(20)
  CreatedDate          DateTime? @default(now()) @db.DateTime
  CreatedBy            String?   @db.VarChar(20)
  UpdatedDate          DateTime? @db.DateTime
  UpdatedBy            String?   @db.VarChar(20)

  LeaveRequests TrnLeaveRequest[]
  LeaveBalances MstEmployeeLeaveBalance[]
  TenureTiers   MstLeaveTenureTier[]

  @@map("mst_leave_type")
}

// Step table for BasedOnTenure leave types (2026-09-21, e.g. ลาพักร้อน):
// "at MinYearsOfService completed years of service or more, entitlement is
// EntitledDays" — entitlement lookup takes the highest-threshold row whose
// MinYearsOfService <= the employee's actual completed years (e.g. rows for
// 1yr=6days, 2yr=7days: an employee with 1.9 years gets 6, not 7, until they
// cross the 2-year mark). Below the lowest threshold, entitlement is 0.
model MstLeaveTenureTier {
  TenureTierID      Int       @id(map: "PK_mst_leave_tenure_tier") @default(autoincrement())
  LeaveTypeCode     String    @db.VarChar(10)
  MinYearsOfService Int       @db.SmallInt
  EntitledDays      Decimal   @db.Decimal(4, 1)
  CreatedDate       DateTime? @default(now()) @db.DateTime
  CreatedBy         String?   @db.VarChar(20)
  UpdatedDate       DateTime? @db.DateTime
  UpdatedBy         String?   @db.VarChar(20)

  LeaveType MstLeaveType @relation(fields: [LeaveTypeCode], references: [LeaveTypeCode], map: "FK_mst_leave_tenure_tier_type", onUpdate: NoAction, onDelete: NoAction)

  @@unique([LeaveTypeCode, MinYearsOfService], map: "UQ_mst_leave_tenure_tier")
  @@map("mst_leave_tenure_tier")
}

model TrnLeaveRequest {
  LeaveID        Int       @id(map: "PK_trn_leave_request") @default(autoincrement())
  EmpCode        String    @db.VarChar(15)
  LeaveTypeCode  String    @db.VarChar(10)
  // 2026-09-21 workflow overhaul (mirrors Request & Approve's approve/reject
  // cycle, but NOT its header+detail restructure — still 1 row = 1 employee's
  // 1 leave request, per explicit user decision). DocumentNo runs off
  // ref_document_number code "LEAVE". IsFullDay=false means the request was
  // entered in hours (HoursRequested populated, single day only, TotalDays
  // derived as HoursRequested/8 — the approved 8h=1day conversion); TotalDays
  // is always the canonical day-equivalent value balance checks compare
  // against, regardless of entry mode.
  DocumentNo      String?   @db.VarChar(20)
  StartDate       DateTime  @db.Date
  EndDate         DateTime  @db.Date
  IsFullDay       Boolean   @default(true)
  // Decimal(5,2), not (4,1) like every other day-count column in this
  // project (e.g. mst_employee_leave_balance) — found via testing 2026-09-21
  // that HoursRequested/8 for ordinary whole-hour inputs (1h,2h,3h,5h,6h,7h)
  // needs 2 decimal places (e.g. 2h -> 0.25) and Decimal(4,1) was silently
  // rounding it (0.25 -> 0.3), corrupting the balance math. Only these two
  // columns needed widening — MstLeaveTenureTier.EntitledDays stays (4,1)
  // since tenure tiers are configured in whole/half days, not hours.
  HoursRequested  Decimal?  @db.Decimal(5, 2)
  TotalDays       Decimal   @db.Decimal(5, 2)
  HasMedicalCert  Boolean   @default(false)
  Status          String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED | REJECTED
  CreatedBy       String    @db.VarChar(20)
  CreatedDate     DateTime  @default(now()) @db.DateTime
  ApprovedBy      String?   @db.VarChar(20)
  ApprovedDate    DateTime? @db.DateTime
  // Reject now bounces Status back to DRAFT (like trn_request) instead of a
  // terminal REJECTED value — RejectReason/RejectedBy/RejectedDate persist as
  // audit trail even after a later resubmission, same convention as
  // trn_request_header.
  RejectReason    String?   @db.NVarChar(500)
  RejectedBy      String?   @db.VarChar(20)
  RejectedDate    DateTime? @db.DateTime
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  Employee  MstEmployee  @relation(fields: [EmpCode], references: [EmpCode], map: "FK_trn_leave_request_employee", onUpdate: NoAction, onDelete: NoAction)
  LeaveType MstLeaveType @relation(fields: [LeaveTypeCode], references: [LeaveTypeCode], map: "FK_trn_leave_request_type", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser      @relation("LeaveCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_trn_leave_request_created_by", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?     @relation("LeaveApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_trn_leave_request_approved_by", onUpdate: NoAction, onDelete: NoAction)

  @@map("trn_leave_request")
}

model MstEmployeeLeaveBalance {
  BalanceID     Int       @id(map: "PK_mst_employee_leave_balance") @default(autoincrement())
  EmpCode       String    @db.VarChar(15)
  LeaveTypeCode String    @db.VarChar(10)
  Year          Int       @db.SmallInt
  Entitled      Decimal   @default(0) @db.Decimal(4, 1)
  Used          Decimal   @default(0) @db.Decimal(4, 1)
  Remaining     Decimal   @default(0) @db.Decimal(4, 1)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  Employee  MstEmployee  @relation(fields: [EmpCode], references: [EmpCode], map: "FK_mst_employee_leave_balance_employee", onUpdate: NoAction, onDelete: NoAction)
  LeaveType MstLeaveType @relation(fields: [LeaveTypeCode], references: [LeaveTypeCode], map: "FK_mst_employee_leave_balance_type", onUpdate: NoAction, onDelete: NoAction)

  @@unique([EmpCode, LeaveTypeCode, Year], map: "UQ_mst_employee_leave_balance")
  @@map("mst_employee_leave_balance")
}
