// Prisma schema for ABC CO., LTD. HR & Payroll System
// Mirrors the approved HFC_System_Database_DDL.sql (33 tables) + sys_session
// (34th table, approved 2026-09-15 for session-based auth).
//
// Conventions:
// - Model names are PascalCase; @@map keeps the original snake_case table name.
// - Field names match the DDL column names exactly (no @map needed per field).
// - PK/FK/UNIQUE/INDEX constraint names are preserved via `map:` to match the DDL 1:1.
// - CHECK constraints from the DDL are NOT expressible in Prisma schema syntax —
//   they are re-added by hand-editing the generated migration.sql (see migration
//   0001_init) so the DB still enforces them exactly as approved. Valid values are
//   documented as comments below.
// - `RowVer` (ROWVERSION) columns use Unsupported("rowversion") — SQL Server
//   maintains these automatically; Prisma Client cannot select/write them directly,
//   use $queryRaw for optimistic-concurrency checks against these columns.
// - CreatedDate/CreatedBy/UpdatedDate/UpdatedBy (added 2026-09-17 at the user's
//   request, to every table): standard audit columns, nullable (existing seeded
//   rows and tables predating this migration have no real acting user for them).
//   CreatedBy/UpdatedBy are plain VARCHAR(20), no FK to sys_user — matching the
//   precedent already set by SubmittedBy/ApprovedBy/RejectedBy on
//   trn_worksheet_header and UpdatedBy on trn_worksheet_daily ("ไม่มี FK ใน DDL
//   ที่อนุมัติ (ตั้งใจ)") — adding ~34 more named relations onto sys_user for
//   this alone would make that model unwieldy for little real benefit. Skipped
//   wherever a table already has an identically-named field (e.g. trn_request's
//   own CreatedBy/CreatedDate) — those are left untouched, only the missing half
//   of the pair is added. Tables that already carry an equivalent field under a
//   different name (ref_black_list.AddedDate, mst_employee_history.RecordedBy/
//   RecordedDate, trn_payroll_calculate_log.CalculatedBy/CalculatedDate,
//   trn_payroll_lock.LockedBy/LockedDate) still get the new standard columns
//   alongside for uniform querying, even though it's some redundancy — a
//   deliberate tradeoff for "the same 4 columns work the same way on every
//   table" over trying to reuse fields with different semantics.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ============================================================
// mst_site — referenced by many tables
// ============================================================
model MstSite {
  SiteCode    String    @id(map: "PK_mst_site") @db.VarChar(10)
  SiteName    String    @db.NVarChar(150)
  IsActive    Boolean   @default(true)
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  Users                     SysUser[]
  Permissions               SysUserPermission[]
  Employees                 MstEmployee[]
  WorksheetHeaders          TrnWorksheetHeader[]
  PayrollTransactions       TrnPayrollTransaction[]
  RequiredPositions         MstSitePosition[]
  PayrollTransactionDetails TrnPayrollTransactionDetail[]

  @@map("mst_site")
}

// Which positions a site needs, and what each one pays there (2026-09-21) —
// a staffing/pay-rate plan per site, separate from mst_employee.DailyRate
// (an individual employee's actual rate). Informational only for now: not
// wired into Worksheet/Payroll calculation, same as ref_income_type itself
// wasn't wired into trn_payroll_transaction — that would be a separate,
// larger decision.
model MstSitePosition {
  SitePositionID Int       @id(map: "PK_mst_site_position") @default(autoincrement())
  SiteCode       String    @db.VarChar(10)
  PositionCode   String    @db.VarChar(10)
  CreatedDate    DateTime? @default(now()) @db.DateTime
  CreatedBy      String?   @db.VarChar(20)
  UpdatedDate    DateTime? @db.DateTime
  UpdatedBy      String?   @db.VarChar(20)

  Site       MstSite                 @relation(fields: [SiteCode], references: [SiteCode], map: "FK_mst_site_position_site", onUpdate: NoAction, onDelete: NoAction)
  Position   RefPosition             @relation(fields: [PositionCode], references: [PositionCode], map: "FK_mst_site_position_position", onUpdate: NoAction, onDelete: NoAction)
  IncomeRows MstSitePositionIncome[]

  @@unique([SiteCode, PositionCode], map: "UQ_mst_site_position")
  @@map("mst_site_position")
}

model MstSitePositionIncome {
  SitePositionIncomeID Int       @id(map: "PK_mst_site_position_income") @default(autoincrement())
  SitePositionID       Int
  IncomeCode           String    @db.VarChar(10)
  Amount               Decimal   @db.Decimal(10, 2)
  RateBasis            String    @default("DAILY") @db.VarChar(10) // CHECK: DAILY | MONTHLY
  CreatedDate          DateTime? @default(now()) @db.DateTime
  CreatedBy            String?   @db.VarChar(20)
  UpdatedDate          DateTime? @db.DateTime
  UpdatedBy            String?   @db.VarChar(20)

  SitePosition MstSitePosition @relation(fields: [SitePositionID], references: [SitePositionID], map: "FK_mst_site_position_income_site_position", onUpdate: NoAction, onDelete: NoAction)
  IncomeType   RefIncomeType   @relation(fields: [IncomeCode], references: [IncomeCode], map: "FK_mst_site_position_income_income_type", onUpdate: NoAction, onDelete: NoAction)

  @@unique([SitePositionID, IncomeCode], map: "UQ_mst_site_position_income")
  @@map("mst_site_position_income")
}

// "รายได้พื้นฐาน" per position (2026-09-21) — same shape as
// mst_site_position_income, one level up (no Site dimension). Two fallback
// uses, both confirmed with user: (1) Worksheet — if an employee has no
// mst_employee.DailyRate set, ONLY this position's IncomeCode="01" (ค่าแรง)
// row is read as the effective daily rate for that employee's worksheet
// snapshot (Worksheet has no OT/allowance concept at all — just
// DailyRate × attendance PayMultiplier per day, so only "01" applies there).
// (2) "อัตรากำลังพล" rate lookup for "รายการประจำงวด" — if a site+position
// combo (mst_site_position_income) has no row for a given IncomeCode, fall
// back to this table for that PositionCode+IncomeCode instead; applies
// generically to whatever codes the user configures here (e.g. "05" โอที 1
// for ค่า OT ต่อวัน, "15" ค่าตำแหน่ง), not hardcoded to just those two.
model MstPositionIncome {
  PositionIncomeID Int       @id(map: "PK_mst_position_income") @default(autoincrement())
  PositionCode     String    @db.VarChar(10)
  IncomeCode       String    @db.VarChar(10)
  Amount           Decimal   @db.Decimal(10, 2)
  RateBasis        String    @default("DAILY") @db.VarChar(10) // CHECK: DAILY | MONTHLY
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  Position   RefPosition   @relation(fields: [PositionCode], references: [PositionCode], map: "FK_mst_position_income_position", onUpdate: NoAction, onDelete: NoAction)
  IncomeType RefIncomeType @relation(fields: [IncomeCode], references: [IncomeCode], map: "FK_mst_position_income_income_type", onUpdate: NoAction, onDelete: NoAction)

  @@unique([PositionCode, IncomeCode], map: "UQ_mst_position_income")
  @@map("mst_position_income")
}

// ============================================================
// โมดูล 2: ตารางอ้างอิงพื้นฐาน
// ============================================================
model RefDepartment {
  DeptCode    String    @id(map: "PK_ref_department") @db.VarChar(10)
  DeptName    String    @db.NVarChar(100)
  IsActive    Boolean   @default(true)
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  Employees MstEmployee[]

  @@map("ref_department")
}

model RefPosition {
  PositionCode      String    @id(map: "PK_ref_position") @db.VarChar(10)
  PositionName      String    @db.NVarChar(100)
  PositionAllowance Decimal   @default(0) @db.Decimal(10, 2)
  IsActive          Boolean   @default(true)
  CreatedDate       DateTime? @default(now()) @db.DateTime
  CreatedBy         String?   @db.VarChar(20)
  UpdatedDate       DateTime? @db.DateTime
  UpdatedBy         String?   @db.VarChar(20)

  Employees                 MstEmployee[]
  SitePositions             MstSitePosition[]
  BaseIncomes               MstPositionIncome[]
  WorksheetDetails          TrnWorksheetDetail[]
  PayrollTransactionDetails TrnPayrollTransactionDetail[]

  @@map("ref_position")
}

model RefBank {
  BankCode    String    @id(map: "PK_ref_bank") @db.VarChar(10)
  BankNameTH  String    @db.NVarChar(100)
  BankNameEN  String    @db.NVarChar(100)
  IsActive    Boolean   @default(true)
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  Employees MstEmployee[]

  @@map("ref_bank")
}

model RefSsoBase {
  SSOBaseID     Int       @id(map: "PK_ref_sso_base") @default(autoincrement())
  EffectiveYear Int       @db.SmallInt
  EffectiveDate DateTime? @db.Date
  MinBase       Decimal   @db.Decimal(10, 2)
  MaxBase       Decimal   @db.Decimal(10, 2)
  EmployeeRate  Decimal   @db.Decimal(5, 4)
  EmployerRate  Decimal   @db.Decimal(5, 4)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  @@map("ref_sso_base")
}

// Added 2026-09-19 at the user's request — "กองทุนสงเคราะห์พนักงาน" (Employee
// Welfare Fund), tab added right after ฐานประกันสังคม in /reference.
// Same shape as RefSsoBase but without MinBase/MaxBase (no wage-base ceiling
// concept for this fund, just flat employee/employer rates per year).
model RefWelfareFund {
  WelfareFundID Int       @id(map: "PK_ref_welfare_fund") @default(autoincrement())
  EffectiveYear Int       @db.SmallInt
  EffectiveDate DateTime? @db.Date
  EmployeeRate  Decimal   @db.Decimal(5, 4)
  EmployerRate  Decimal   @db.Decimal(5, 4)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  @@map("ref_welfare_fund")
}

// Added 2026-09-17 at the user's request — BR-009 already described
// "กำหนดข้อมูลบริษัท" (configure company data) as part of System > Reference
// > Tax & Rate, but no table for it existed in the originally approved
// 33-table DDL. Standalone reference data, no FK from any other table.
model RefCompany {
  CompanyCode  String    @id(map: "PK_ref_company") @db.VarChar(10)
  CompanyName  String    @db.NVarChar(150)
  ShortName    String?   @db.NVarChar(50) // ชื่อย่อ — shown in the app brand footer/title in place of the hardcoded "ABC CO., LTD."
  Address      String?   @db.NVarChar(300)
  TaxID        String?   @db.VarChar(20)
  SSORegistNo  String?   @db.VarChar(20)
  ContactPhone String?   @db.VarChar(20)
  CreatedDate  DateTime? @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  // เอกสารประกอบงาน (2026-09-23) — ข้อเท็จจริงระดับบริษัทที่จำเป็นสำหรับ
  // แบบ ธ.ภ.6/NDA (เลขที่ใบอนุญาตธุรกิจ รปภ., ผู้มีอำนาจลงนาม, วันที่/
  // จังหวัดจดทะเบียน, ที่อยู่แยกส่วน) — ไม่มีในสคีมาเดิมเลย เพิ่มคู่ขนานกับ
  // Address เดิม (Address เดิมยังใช้เป็น header ของรายงานอื่นต่อไปตามปกติ)
  SecurityBusinessLicenseNo String?   @db.VarChar(30)
  AuthorizedSignerName      String?   @db.NVarChar(150)
  AuthorizedSignerPosition  String?   @db.NVarChar(100)
  RegisteredDate            DateTime? @db.Date
  RegisteredProvince        String?   @db.NVarChar(50)
  AddressHouseNo            String?   @db.NVarChar(20)
  AddressFloor              String?   @db.NVarChar(20)
  AddressMoo                String?   @db.NVarChar(10)
  AddressSoi                String?   @db.NVarChar(50)
  AddressRoad               String?   @db.NVarChar(50)
  AddressTambon              String?   @db.NVarChar(50)
  AddressAmphoe             String?   @db.NVarChar(50)
  AddressProvince           String?   @db.NVarChar(50)
  AddressZipCode            String?   @db.VarChar(10)

  Employees MstEmployee[]

  @@map("ref_company")
}

// Running document-number sequences (e.g. for future auto-numbered
// documents) — a new reference table, not part of the original 34-table
// DDL. NextNumber isn't a stored column: it's derived from LatestNumber +
// UseYearMonthPrefix and computed server-side on every read (see
// src/app/api/reference/document-numbers/route.ts).
model RefDocumentNumber {
  DocumentNumberID   Int       @id(map: "PK_ref_document_number") @default(autoincrement())
  DocumentCode       String    @unique(map: "UQ_ref_document_number_DocumentCode") @db.VarChar(30)
  Description        String?   @db.NVarChar(200)
  IsCustomNumber     Boolean   @default(false) // กำหนดเอง — when true, numbering isn't auto-generated (UseYearMonthPrefix/LatestNumber/NextNumber don't apply, hidden in the UI)
  UseYearMonthPrefix Boolean   @default(false)
  LatestNumber       Int       @default(0)
  CreatedDate        DateTime? @default(now()) @db.DateTime
  CreatedBy          String?   @db.VarChar(20)
  UpdatedDate        DateTime? @db.DateTime
  UpdatedBy          String?   @db.VarChar(20)

  @@map("ref_document_number")
}

model RefBlackList {
  BlackListID Int       @id(map: "PK_ref_black_list") @default(autoincrement())
  IDCardNo    String    @db.VarChar(20)
  FullName    String    @db.NVarChar(150)
  Reason      String?   @db.NVarChar(300)
  AddedDate   DateTime  @default(now()) @db.DateTime
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  @@map("ref_black_list")
}

model RefTaxBracket {
  BracketID     Int       @id(map: "PK_ref_tax_bracket") @default(autoincrement())
  EffectiveYear Int       @db.SmallInt
  IncomeFrom    Decimal   @db.Decimal(12, 2)
  IncomeTo      Decimal   @db.Decimal(12, 2)
  TaxRate       Decimal   @db.Decimal(5, 4)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  @@map("ref_tax_bracket")
}

model RefDeductionRate {
  DeductionCode String    @id(map: "PK_ref_deduction_rate") @db.VarChar(20)
  DeductionName String    @db.NVarChar(100)
  Rate          Decimal?  @db.Decimal(5, 4)
  MaxAmount     Decimal   @db.Decimal(12, 2)
  EffectiveYear Int       @db.SmallInt
  SortOrder     Int?      @db.SmallInt
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  @@map("ref_deduction_rate")
}

// Added 2026-09-19 at the user's request — a menu item "รายได้และรายการหัก"
// (Income & Deduction Types) under ตั้งค่าระบบ/รหัสอ้างอิง, 2 tabs. Plain
// code+name reference tables, no FK from any other table yet (informational
// master data only — trn_payroll_transaction's OtherIncome/OtherDeduction
// are still free-form amounts, not linked to a type code).
model RefIncomeType {
  IncomeCode  String    @id(map: "PK_ref_income_type") @db.VarChar(10)
  IncomeName  String    @db.NVarChar(100)
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  SitePositionIncomes MstSitePositionIncome[]
  PositionIncomes     MstPositionIncome[]

  @@map("ref_income_type")
}

model RefDeductionType {
  DeductionCode    String    @id(map: "PK_ref_deduction_type") @db.VarChar(10)
  DeductionName    String    @db.NVarChar(100)
  IsInstallment    Boolean   @default(false)
  // 2026-09-21 — deduction types the system already computes elsewhere
  // (ภาษี → TaxWithheld, ประกันสังคม → SSOAmount via Calculate; กองทุน
  // สงเคราะห์พนักงาน grouped in by the user alongside them) should not be
  // offered as an ad-hoc manual line on the "รายการประจำงวด" screen — same
  // rationale/pattern as IsInstallment excluding installment debts from
  // there (those belong on the employee's "รายการหักต่องวด" tab instead).
  IsAutoCalculated Boolean   @default(false)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  InstallmentDebts InvEmployeeDebt[]

  @@map("ref_deduction_type")
}

// ============================================================
// โมดูล 1: ผู้ใช้งานและสิทธิ์ (User & Authorization)
// ============================================================
model SysMenu {
  DocumentType String    @id(map: "PK_sys_menu") @db.VarChar(20)
  MenuNameTH   String    @db.NVarChar(100)
  MenuNameEN   String    @db.NVarChar(100)
  ModuleGroup  String    @db.VarChar(30)
  IsActive     Boolean   @default(true)
  CreatedDate  DateTime? @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  Permissions SysUserPermission[]

  @@map("sys_menu")
}

model SysUser {
  UserID          String    @id(map: "PK_sys_user") @db.VarChar(20)
  PasswordHash    String    @db.VarChar(255)
  DisplayName     String    @db.NVarChar(100)
  Email           String?   @db.NVarChar(100)
  Role            String    @db.VarChar(20) // CHECK: SITE_HEAD | APPROVER | ADMIN | PAYROLL | HR | STORE
  DefaultSiteCode String?   @db.VarChar(10)
  IsActive        Boolean   @default(true)
  CreatedDate     DateTime  @default(now()) @db.DateTime
  LastLoginDate   DateTime? @db.DateTime
  CreatedBy       String?   @db.VarChar(20)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  DefaultSite MstSite? @relation(fields: [DefaultSiteCode], references: [SiteCode], map: "FK_sys_user_mst_site", onUpdate: NoAction, onDelete: NoAction)

  Permissions               SysUserPermission[]
  ProcessLogs               SysProcessLog[]
  Sessions                  SysSession[]
  RecordedEmployeeHistory   MstEmployeeHistory[]
  CreatedRequestHeaders     TrnRequestHeader[]       @relation("RequestHeaderCreatedBy")
  ApprovedRequestHeaders    TrnRequestHeader[]       @relation("RequestHeaderApprovedBy")
  RejectedRequestHeaders    TrnRequestHeader[]       @relation("RequestHeaderRejectedBy")
  CreatedStockMovements     InvStockMovement[]
  CreatedWorksheetHeaders   TrnWorksheetHeader[]
  CalculatedPayrollLogs     TrnPayrollCalculateLog[]
  PayrollLocks              TrnPayrollLock[]         @relation("PayrollLockLockedBy")
  ApprovedPayrollLocks      TrnPayrollLock[]         @relation("PayrollLockApprovedBy")
  CreatedLeaveRequests      TrnLeaveRequest[]        @relation("LeaveCreatedBy")
  ApprovedLeaveRequests     TrnLeaveRequest[]        @relation("LeaveApprovedBy")
  CreatedStockCountHeaders  InvStockCountHeader[]    @relation("StockCountHeaderCreatedBy")
  ApprovedStockCountHeaders InvStockCountHeader[]    @relation("StockCountHeaderApprovedBy")
  RejectedStockCountHeaders InvStockCountHeader[]    @relation("StockCountHeaderRejectedBy")
  CreatedPurchaseHeaders    InvPurchaseHeader[]      @relation("PurchaseHeaderCreatedBy")
  ApprovedPurchaseHeaders   InvPurchaseHeader[]      @relation("PurchaseHeaderApprovedBy")
  RejectedPurchaseHeaders   InvPurchaseHeader[]      @relation("PurchaseHeaderRejectedBy")
  CreatedTransferHeaders    InvTransferHeader[]      @relation("TransferHeaderCreatedBy")
  ApprovedTransferHeaders   InvTransferHeader[]      @relation("TransferHeaderApprovedBy")
  RejectedTransferHeaders   InvTransferHeader[]      @relation("TransferHeaderRejectedBy")
  CreatedIssueHeaders       InvIssueHeader[]         @relation("IssueHeaderCreatedBy")
  ApprovedIssueHeaders      InvIssueHeader[]         @relation("IssueHeaderApprovedBy")
  RejectedIssueHeaders      InvIssueHeader[]         @relation("IssueHeaderRejectedBy")
  CreatedReturnHeaders      InvReturnHeader[]        @relation("ReturnHeaderCreatedBy")
  ApprovedReturnHeaders     InvReturnHeader[]        @relation("ReturnHeaderApprovedBy")
  RejectedReturnHeaders     InvReturnHeader[]        @relation("ReturnHeaderRejectedBy")

  @@map("sys_user")
}

model SysUserPermission {
  PermissionID Int       @id(map: "PK_sys_user_permission") @default(autoincrement())
  UserID       String    @db.VarChar(20)
  DocumentType String    @db.VarChar(20)
  SiteCode     String?   @db.VarChar(10)
  CanRead      Boolean   @default(false)
  CanSave      Boolean   @default(false)
  CanDelete    Boolean   @default(false)
  CanApprove   Boolean   @default(false)
  CreatedDate  DateTime? @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  Menu SysMenu  @relation(fields: [DocumentType], references: [DocumentType], map: "FK_sys_user_permission_sys_menu", onUpdate: NoAction, onDelete: NoAction)
  User SysUser  @relation(fields: [UserID], references: [UserID], map: "FK_sys_user_permission_sys_user", onUpdate: NoAction, onDelete: NoAction)
  Site MstSite? @relation(fields: [SiteCode], references: [SiteCode], map: "FK_sys_user_permission_mst_site", onUpdate: NoAction, onDelete: NoAction)

  @@unique([UserID, DocumentType, SiteCode], map: "UQ_sys_user_permission")
  @@map("sys_user_permission")
}

// ============================================================
// โมดูล 2 (ต่อ): ตารางที่ต้องมี sys_user ก่อน
// ============================================================
model SysPeriod {
  PeriodID     Int       @id(map: "PK_sys_period") @default(autoincrement())
  EmployeeType String    @db.VarChar(20)
  PeriodYear   Int       @db.SmallInt
  PeriodMonth  Int       @db.TinyInt
  StartDate    DateTime  @db.Date
  EndDate      DateTime  @db.Date
  PayDate      DateTime  @db.Date
  Status       String    @default("OPEN") @db.VarChar(10) // CHECK: OPEN | CLOSED
  IsCurrent    Boolean   @default(false) // at most one TRUE per EmployeeType — enforced in the API, not the DB
  CreatedDate  DateTime  @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  PayrollTransactions  TrnPayrollTransaction[]
  PayrollCalculateLogs TrnPayrollCalculateLog[]
  PayrollLocks         TrnPayrollLock[]

  @@map("sys_period")
}

// Added 2026-09-21 at the user's request — "System Configuration", a new
// top-most sidebar menu for system-wide default/startup values. Singleton
// table by design ("มีแต่บันทึก 1 record") — SysConfigID is always 1, no
// UI ever creates a second row (getOrCreateSystemConfig() in
// src/lib/system-config.ts is the only writer of a fresh row, and it always
// targets ID 1). Field names/types are exactly as specified by the user.
model SysConfig {
  SysConfigID      Int       @id(map: "PK_sys_config") @default(1)
  RegistrationCode String?   @db.NVarChar(100)
  AccessKey        String?   @db.NVarChar(100)
  PassChecking     Boolean   @default(false)
  ContactPerson    String?   @db.NVarChar(100)
  Tel              String?   @db.NVarChar(100)
  FileFolder       String?   @db.NVarChar(100)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  @@map("sys_config")
}

model SysProcessLog {
  LogID       BigInt    @id(map: "PK_sys_process_log") @default(autoincrement())
  UserID      String    @db.VarChar(20)
  ActionType  String    @db.VarChar(50)
  TargetTable String?   @db.VarChar(50)
  TargetID    String?   @db.VarChar(50)
  ActionDate  DateTime  @default(now()) @db.DateTime
  Detail      String?   @db.NVarChar(500)
  Changes     String?   @db.NVarChar(Max) // JSON: {"FieldName": {"old": ..., "new": ...}, ...} — old/new value diff for UPDATE actions (see computeDiff() in src/lib/audit-log.ts). Started with the Employee module 2026-09-19, rolling out to other modules next.
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  User SysUser @relation(fields: [UserID], references: [UserID], map: "FK_sys_process_log_sys_user", onUpdate: NoAction, onDelete: NoAction)

  @@index([ActionDate], map: "IX_sys_process_log_ActionDate")
  @@map("sys_process_log")
}

// ============================================================
// โมดูล 1 (ใหม่): Session storage สำหรับ Session/Cookie Auth
// อนุมัติเพิ่ม 2026-09-15 — ไม่อยู่ใน HFC_System_Database_DDL.sql เดิม
// ============================================================
model SysSession {
  SessionID        String    @id(map: "PK_sys_session") @db.VarChar(64)
  UserID           String    @db.VarChar(20)
  CreatedDate      DateTime  @default(now()) @db.DateTime
  LastActivityDate DateTime  @default(now()) @db.DateTime
  ExpiresDate      DateTime  @db.DateTime
  IPAddress        String?   @db.VarChar(45)
  UserAgent        String?   @db.NVarChar(255)
  IsRevoked        Boolean   @default(false)
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  User SysUser @relation(fields: [UserID], references: [UserID], map: "FK_sys_session_sys_user", onUpdate: NoAction, onDelete: NoAction)

  @@index([UserID], map: "IX_sys_session_UserID")
  @@index([ExpiresDate], map: "IX_sys_session_ExpiresDate")
  @@map("sys_session")
}

// ============================================================
// โมดูล 3: ข้อมูลหลักพนักงาน (Employee Master)
// ============================================================
model MstEmployee {
  EmpCode         String    @id(map: "PK_mst_employee") @db.VarChar(15)
  // UNIQUE constraint intentionally dropped 2026-09-19 (was
  // UQ_mst_employee_IDCardNo) — approved re-hire design allows a person to
  // have more than one mst_employee row over separate employment stints,
  // each under its own EmpCode. See CLAUDE.md for the alternative that was
  // NOT chosen (reactivating the old EmpCode instead of a new row).
  IDCardNo        String    @db.VarChar(20)
  FullName        String    @db.NVarChar(150)
  Address         String?   @db.NVarChar(300)
  EmployeeStatus  String    @default("ACTIVE") @db.VarChar(10) // CHECK: ACTIVE | RESIGNED | PROBATION | SUSPENDED | TERMINATED (expanded 2026-09-19 — "ACTIVE" is the DB value for "ปกติ", kept as-is since 4 existing pages filter on it)
  StartDate       DateTime  @db.Date
  ResignDate      DateTime? @db.Date
  DeptCode        String?   @db.VarChar(10)
  PositionCode    String?   @db.VarChar(10)
  DefaultSiteCode String?   @db.VarChar(10)
  EmployeeType    String    @db.VarChar(20)
  BankCode        String?   @db.VarChar(10)
  BankAccountNo   String?   @db.VarChar(20)
  DailyRate       Decimal?  @db.Decimal(10, 2)
  // Both store a Google Drive file ID (2026-09-21), not a filesystem path
  // despite the column name/original DDL intent — PhotoPath existed unused
  // since the original 33-table design; IDCardPhotoPath is new. Never a
  // public Drive link — see src/lib/google-drive.ts for why.
  PhotoPath       String?   @db.NVarChar(255)
  IDCardPhotoPath String?   @db.NVarChar(255)
  IsActive        Boolean   @default(true)
  CreatedDate     DateTime  @default(now()) @db.DateTime
  CreatedBy       String?   @db.VarChar(20)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  // Added 2026-09-19 — ทะเบียนประวัติพนักงาน overhaul (see CLAUDE.md).
  // All nullable: existing rows have none of this data, and it's filled in
  // gradually by HR through the employee detail page after creation, same
  // pattern already established for DailyRate/PhotoPath.
  Title                        String?   @db.NVarChar(20)
  FirstName                    String?   @db.NVarChar(100)
  LastName                     String?   @db.NVarChar(100)
  BirthDate                    DateTime? @db.Date
  CompanyCode                  String?   @db.VarChar(10)
  ProbationPassDate            DateTime? @db.Date
  CertificateNo                String?   @db.VarChar(50)
  IDCardIssuedBy               String?   @db.NVarChar(100)
  IDCardIssueDate              DateTime? @db.Date
  IDCardExpiryDate             DateTime? @db.Date
  IDCardAddress                String?   @db.NVarChar(300)
  PhoneNo                      String?   @db.VarChar(20)
  EmergencyContactName         String?   @db.NVarChar(150)
  EmergencyContactPhone        String?   @db.VarChar(20)
  GuarantorName                String?   @db.NVarChar(150)
  // Deliberately stored only, not wired into calculateTaxWithheld() — the
  // approved payroll tax design uses a single flat PERSONAL deduction only
  // (see CLAUDE.md, Payroll module). Confirmed with the user 2026-09-19.
  MaritalStatus                String?   @db.VarChar(10) // suggested: SINGLE | MARRIED | DIVORCED | WIDOWED — no DB CHECK, informational
  ChildrenCount                Int?      @default(0)
  ParentSupportAmount          Decimal?  @db.Decimal(12, 2) // อุปการะบิดามารดา
  LifeInsurancePremium         Decimal?  @db.Decimal(12, 2) // เบี้ยประกันชีวิต
  HealthInsurancePremium       Decimal?  @db.Decimal(12, 2) // เบี้ยประกันสุขภาพ
  ParentHealthInsurancePremium Decimal?  @db.Decimal(12, 2) // เบี้ยประกันสุขภาพบิดามารดา
  RMFPurchaseAmount            Decimal?  @db.Decimal(12, 2) // ยอดซื้อกองทุน RMF ในปี
  HomeLoanInterestAmount       Decimal?  @db.Decimal(12, 2) // ยอดดอกเบี้ยบ้าน
  DonationAmount               Decimal?  @db.Decimal(12, 2) // ยอดเงินบริจาค
  // Free-text cross-reference codes, not enforced FKs — same rationale as
  // CreatedBy/UpdatedBy elsewhere: a strict FK to mst_employee (self) or
  // ref_black_list would add relation complexity disproportionate to what's
  // essentially a lookup note.
  ReferrerEmpCode              String?   @db.VarChar(15) // รหัสคนแนะนำ
  BlacklistCode                String?   @db.VarChar(20) // รหัสแบล็คลิส (ref_black_list.IDCardNo, cross-referenced manually)
  BloodType                    String?   @db.VarChar(5)
  Height                       Decimal?  @db.Decimal(5, 1) // cm
  Weight                       Decimal?  @db.Decimal(5, 1) // kg
  BodyType                     String?   @db.NVarChar(50)
  DistinguishingMarks          String?   @db.NVarChar(200) // ตำหนิ
  Gender                       String?   @db.VarChar(10) // suggested: MALE | FEMALE | OTHER — no DB CHECK, informational
  Religion                     String?   @db.NVarChar(50)
  Ethnicity                    String?   @db.NVarChar(50) // เชื้อชาติ
  Nationality                  String?   @db.NVarChar(50) // สัญชาติ
  Education                    String?   @db.VarChar(20) // วุฒิการศึกษา — see EDUCATION_LEVEL_VALUES, no DB CHECK, informational
  // ใบอนุญาตตาม พ.ร.บ.ธุรกิจรักษาความปลอดภัย (เฉพาะธุรกิจ รปภ. ของบริษัทนี้)
  LicenseNo6                   String?   @db.VarChar(50) // เลขที่ใบอนุญาต ธภ.6
  LicenseDate6                 DateTime? @db.Date // ลงวันที่ ธภ.6
  LicenseNo7                   String?   @db.VarChar(50) // เลขที่ใบอนุญาต ธภ.7
  LicenseDate7                 DateTime? @db.Date // ลงวันที่ ธภ.7
  // เช็คลิสต์หลักสูตรฝึกอบรม ธภ.7 (2026-09-22) — 10 หัวข้อตามหลักสูตรที่
  // กฎหมายกำหนด แต่ละหัวข้อเป็น checkbox อิสระ (ผ่าน/ยังไม่ผ่านหัวข้อนั้นๆ) +
  // หมายเหตุ 1 บรรทัดท้ายแบบฟอร์ม — เก็บเป็นคอลัมน์ตรงบน mst_employee ตาม
  // pattern เดียวกับฟิลด์เดี่ยวอื่นๆ ในกลุ่มนี้ (MaritalStatus, LicenseNo6
  // ฯลฯ) ไม่ใช่ตารางแยก เพราะเป็นข้อมูล 1:1 ต่อพนักงานคนเดียว ไม่ใช่รายการซ้ำ
  Tbor7Topic1                  Boolean?  @default(false) // ความรู้เบื้องต้นเกี่ยวกับธุรกิจรักษาความปลอดภัย (ทฤษฎี 2 ชม.)
  Tbor7Topic2                  Boolean?  @default(false) // กฎหมายที่เกี่ยวข้องกับการรักษาความปลอดภัย (ทฤษฎี 2 ชม.)
  Tbor7Topic3                  Boolean?  @default(false) // การรักษาความปลอดภัยขั้นพื้นฐาน (ทฤษฎี 3 ชม. ปฏิบัติ 4 ชม.)
  Tbor7Topic4                  Boolean?  @default(false) // การเขียนรายงาน (ทฤษฎี 1 ชม. ปฏิบัติ 1 ชม.)
  Tbor7Topic5                  Boolean?  @default(false) // การเตรียมพร้อมกรณีเหตุฉุกเฉิน (ทฤษฎี 2 ชม. ปฏิบัติ 3 ชม.)
  Tbor7Topic6                  Boolean?  @default(false) // การติดต่อสื่อสาร (ทฤษฎี 1 ชม. ปฏิบัติ 1 ชม.)
  Tbor7Topic7                  Boolean?  @default(false) // หลักการใช้กำลัง (ทฤษฎี 2 ชม. ปฏิบัติ 2 ชม.)
  Tbor7Topic8                  Boolean?  @default(false) // การปฐมพยาบาลเบื้องต้น (ทฤษฎี 2 ชม. ปฏิบัติ 2 ชม.)
  Tbor7Topic9                  Boolean?  @default(false) // การจัดการจราจร (ทฤษฎี 1 ชม. ปฏิบัติ 2 ชม.)
  Tbor7Topic10                 Boolean?  @default(false) // การฝึกภาคสนาม (ปฏิบัติ 9 ชม.)
  Tbor7Remark                  String?   @db.NVarChar(300) // หมายเหตุ
  // รายได้ — DailyRate already existed; these are new. None of these feed
  // Worksheet/Payroll calculation yet (DailyRate is still the only rate
  // Worksheet snapshots per approved design) — stored for reference only.
  OTRatePerDay                 Decimal?  @db.Decimal(10, 2)
  MonthlySalary                Decimal?  @db.Decimal(12, 2)
  EmployeePositionAllowance    Decimal?  @db.Decimal(10, 2) // per-employee override, distinct from ref_position.PositionAllowance

  // เอกสารประกอบงาน (2026-09-23) — สัญญาว่าจ้าง/NDA/PDPA/ธ.ภ.6 ต้องการที่อยู่
  // แยกเป็นส่วนๆ (บ้านเลขที่/หมู่ที่/ตรอกซอย/ถนน/ตำบล/อำเภอ/จังหวัด/รหัส
  // ไปรษณีย์) ต่างจาก Address/IDCardAddress เดิมที่เป็นข้อความก้อนเดียว —
  // เพิ่มเป็นฟิลด์ใหม่คู่ขนานไป ไม่แตะ Address/IDCardAddress เดิมเลย (จอ/
  // รายงานอื่นที่ใช้ Address เดิมอยู่ไม่กระทบ) ผูกกับ "ที่อยู่ปัจจุบัน"
  // (Address) ไม่ใช่ "ที่อยู่ตามบัตรประชาชน" (IDCardAddress)
  AddressHouseNo       String? @db.NVarChar(20)
  AddressMoo           String? @db.NVarChar(10)
  AddressSoi           String? @db.NVarChar(50)
  AddressRoad          String? @db.NVarChar(50)
  AddressTambon        String? @db.NVarChar(50)
  AddressAmphoe        String? @db.NVarChar(50)
  AddressProvince      String? @db.NVarChar(50)
  AddressZipCode       String? @db.VarChar(10)
  // "บุคคลอ้างอิง" ในรายงาน "ทะเบียนพนักงาน" แบบใหม่ (ประวัติพนักงานรักษา
  // ความปลอดภัย) — คนละแนวคิดกับ EmergencyContactName เดิม (ผู้ติดต่อฉุกเฉิน)
  ReferencePerson1Name String? @db.NVarChar(150)
  ReferencePerson2Name String? @db.NVarChar(150)
  // "สิทธิรักษา" คอลัมน์ในรายงานทะเบียนพนักงาน (2026-09-23, ยืนยันกับผู้ใช้
  // แล้วว่าหมายถึงโรงพยาบาลตามสิทธิ์ประกันสังคม) — ไม่มีฟิลด์นี้มาก่อนเลย
  SSOHospitalName      String? @db.NVarChar(150)

  Department RefDepartment? @relation(fields: [DeptCode], references: [DeptCode], map: "FK_mst_employee_ref_department", onUpdate: NoAction, onDelete: NoAction)
  Position   RefPosition?   @relation(fields: [PositionCode], references: [PositionCode], map: "FK_mst_employee_ref_position", onUpdate: NoAction, onDelete: NoAction)
  Site       MstSite?       @relation(fields: [DefaultSiteCode], references: [SiteCode], map: "FK_mst_employee_mst_site", onUpdate: NoAction, onDelete: NoAction)
  Bank       RefBank?       @relation(fields: [BankCode], references: [BankCode], map: "FK_mst_employee_ref_bank", onUpdate: NoAction, onDelete: NoAction)
  Company    RefCompany?    @relation(fields: [CompanyCode], references: [CompanyCode], map: "FK_mst_employee_ref_company", onUpdate: NoAction, onDelete: NoAction)

  Quotas              MstEmployeeQuota[]
  History             MstEmployeeHistory[]
  RequestDetails      TrnRequestDetail[]
  StockMovements      InvStockMovement[]
  Debts               InvEmployeeDebt[]
  WorksheetDetails    TrnWorksheetDetail[]
  PayrollTransactions TrnPayrollTransaction[]
  LeaveRequests       TrnLeaveRequest[]
  LeaveBalances       MstEmployeeLeaveBalance[]
  WorkExperiences     MstEmployeeWorkExperience[]
  TrainingExperiences MstEmployeeTrainingExperience[]
  IssueHeaders        InvIssueHeader[]
  ReturnHeaders       InvReturnHeader[]

  @@index([DeptCode], map: "IX_mst_employee_DeptCode")
  @@map("mst_employee")
}

// Added 2026-09-19 — ประสบการณ์การทำงาน (repeatable, full CRUD, not
// append-only like mst_employee_history's Note tab).
model MstEmployeeWorkExperience {
  WorkExperienceID Int       @id(map: "PK_mst_employee_work_experience") @default(autoincrement())
  EmpCode          String    @db.VarChar(15)
  CompanyName      String    @db.NVarChar(150)
  PositionName     String?   @db.NVarChar(100)
  Location         String?   @db.NVarChar(200)
  Responsibility   String?   @db.NVarChar(500)
  StartDate        DateTime? @db.Date
  EndDate          DateTime? @db.Date
  ResignReason     String?   @db.NVarChar(300)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  Employee MstEmployee @relation(fields: [EmpCode], references: [EmpCode], map: "FK_mst_employee_work_experience_employee", onUpdate: NoAction, onDelete: NoAction)

  @@map("mst_employee_work_experience")
}

// Added 2026-09-19 — ประสบการณ์การฝึกอบรม (repeatable, full CRUD).
model MstEmployeeTrainingExperience {
  TrainingExperienceID Int       @id(map: "PK_mst_employee_training_experience") @default(autoincrement())
  EmpCode              String    @db.VarChar(15)
  Organization         String    @db.NVarChar(150)
  Location             String?   @db.NVarChar(200)
  Duration             String?   @db.NVarChar(100)
  Topic                String?   @db.NVarChar(300)
  StartDate            DateTime? @db.Date
  EndDate              DateTime? @db.Date
  CertificateNo        String?   @db.VarChar(50)
  CreatedDate          DateTime? @default(now()) @db.DateTime
  CreatedBy            String?   @db.VarChar(20)
  UpdatedDate          DateTime? @db.DateTime
  UpdatedBy            String?   @db.VarChar(20)

  Employee MstEmployee @relation(fields: [EmpCode], references: [EmpCode], map: "FK_mst_employee_training_experience_employee", onUpdate: NoAction, onDelete: NoAction)

  @@map("mst_employee_training_experience")
}

model MstEmployeeQuota {
  QuotaID        Int       @id(map: "PK_mst_employee_quota") @default(autoincrement())
  EmpCode        String    @db.VarChar(15)
  QuotaType      String    @db.VarChar(15) // CHECK: ADVANCE | LOAN | UNIFORM | SERVICE | INSURANCE
  QuotaLimit     Decimal   @default(0) @db.Decimal(12, 2)
  QuotaUsed      Decimal   @default(0) @db.Decimal(12, 2)
  QuotaRemaining Decimal   @default(0) @db.Decimal(12, 2)
  CreatedDate    DateTime? @default(now()) @db.DateTime
  CreatedBy      String?   @db.VarChar(20)
  UpdatedDate    DateTime? @db.DateTime
  UpdatedBy      String?   @db.VarChar(20)

  Employee MstEmployee @relation(fields: [EmpCode], references: [EmpCode], map: "FK_mst_employee_quota_mst_employee", onUpdate: NoAction, onDelete: NoAction)

  @@unique([EmpCode, QuotaType], map: "UQ_mst_employee_quota")
  @@map("mst_employee_quota")
}

model MstEmployeeHistory {
  HistoryID    BigInt    @id(map: "PK_mst_employee_history") @default(autoincrement())
  EmpCode      String    @db.VarChar(15)
  MemoType     String    @db.VarChar(10) // CHECK: GENERAL | ADMIN | FINANCE
  MemoText     String    @db.NVarChar(1000)
  RecordedBy   String    @db.VarChar(20)
  RecordedDate DateTime  @default(now()) @db.DateTime
  CreatedDate  DateTime? @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  Employee MstEmployee @relation(fields: [EmpCode], references: [EmpCode], map: "FK_mst_employee_history_mst_employee", onUpdate: NoAction, onDelete: NoAction)
  Recorder SysUser     @relation(fields: [RecordedBy], references: [UserID], map: "FK_mst_employee_history_sys_user", onUpdate: NoAction, onDelete: NoAction)

  @@map("mst_employee_history")
}

// ============================================================
// โมดูล 4: การขออนุมัติ (Request & Approve)
// แยกเป็น header (1 เอกสาร) + detail (หลายพนักงานต่อเอกสาร) ตั้งแต่ 2026-09-19
// (เดิมเป็นตารางเดียวแบน 1 แถวต่อ 1 พนักงาน) — DocumentCode มาจาก
// REQUEST_DOCUMENT_CODE_VALUES (src/lib/request.ts), DocumentNo มาจากระบบ
// เลขที่เอกสาร (ref_document_number, ดู consumeDocumentNumber ใน
// src/lib/document-number.ts) — ไม่ผูก mst_employee_quota อีกต่อไป (ผู้ใช้
// ยกเลิก design เดิม 2026-09-19) อนุมัติแล้วสร้างแถว inv_employee_debt ต่อ
// รายการพนักงานแทน (เข้าไปอยู่ในแท็บ "รายการหักต่องวด" ของพนักงานคนนั้นเลย)
// ============================================================
model TrnRequestHeader {
  RequestHeaderID Int       @id(map: "PK_trn_request_header") @default(autoincrement())
  DocumentCode    String    @db.VarChar(20) // ADVANCE | ADVANCEN | ADVANCEU | LOAN | TRAINING
  DocumentNo      String?   @db.VarChar(20)
  RequestDate     DateTime  @db.Date
  Remark          String?   @db.NVarChar(300)
  Status          String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED | REJECTED
  CreatedBy       String    @db.VarChar(20)
  CreatedDate     DateTime  @default(now()) @db.DateTime
  SubmittedDate   DateTime? @db.DateTime
  ApprovedBy      String?   @db.VarChar(20)
  ApprovedDate    DateTime? @db.DateTime
  RejectedBy      String?   @db.VarChar(20)
  RejectedDate    DateTime? @db.DateTime
  RejectReason    String?   @db.NVarChar(300)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  Details  TrnRequestDetail[]
  Debts    InvEmployeeDebt[]
  Creator  SysUser            @relation("RequestHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_trn_request_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver SysUser?           @relation("RequestHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_trn_request_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter SysUser?           @relation("RequestHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_trn_request_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)

  @@map("trn_request_header")
}

model TrnRequestDetail {
  RequestDetailID Int       @id(map: "PK_trn_request_detail") @default(autoincrement())
  RequestHeaderID Int
  EmpCode         String    @db.VarChar(15)
  Amount          Decimal   @db.Decimal(12, 2)
  DeductPerPeriod Decimal   @db.Decimal(12, 2)
  CreatedDate     DateTime? @default(now()) @db.DateTime
  CreatedBy       String?   @db.VarChar(20)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  Header   TrnRequestHeader @relation(fields: [RequestHeaderID], references: [RequestHeaderID], map: "FK_trn_request_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Employee MstEmployee      @relation(fields: [EmpCode], references: [EmpCode], map: "FK_trn_request_detail_mst_employee", onUpdate: NoAction, onDelete: NoAction)

  @@index([EmpCode], map: "IX_trn_request_detail_EmpCode")
  @@index([RequestHeaderID], map: "IX_trn_request_detail_RequestHeaderID")
  @@map("trn_request_detail")
}

// ============================================================
// โมดูล 5: สินค้าคงคลัง/เครื่องแบบพนักงาน (Inventory)
// Ledger กลาง inv_stock_movement รองรับทุกประเภทการเคลื่อนไหว
// ============================================================
model InvSupplier {
  SupplierCode String    @id(map: "PK_inv_supplier") @db.VarChar(15)
  SupplierName String    @db.NVarChar(150)
  Address      String?   @db.NVarChar(300)
  ContactPhone String?   @db.VarChar(20)
  IsActive     Boolean   @default(true)
  CreatedDate  DateTime? @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  StockMovements  InvStockMovement[]
  PurchaseHeaders InvPurchaseHeader[]

  @@map("inv_supplier")
}

model InvWarehouse {
  WarehouseCode String    @id(map: "PK_inv_warehouse") @db.VarChar(10)
  WarehouseName String    @db.NVarChar(150)
  IsActive      Boolean   @default(true)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  MovementsFrom         InvStockMovement[]    @relation("MovementSourceWarehouse")
  MovementsTo           InvStockMovement[]    @relation("MovementTargetWarehouse")
  SecondhandStocks      InvSecondhandStock[]
  StockCountHeaders     InvStockCountHeader[]
  PurchaseHeaders       InvPurchaseHeader[]
  TransferHeadersSource InvTransferHeader[]   @relation("TransferHeaderSourceWarehouse")
  TransferHeadersTarget InvTransferHeader[]   @relation("TransferHeaderTargetWarehouse")
  IssueHeaders          InvIssueHeader[]
  ReturnHeaders         InvReturnHeader[]

  @@map("inv_warehouse")
}

model InvProductCategory {
  CategoryCode String    @id(map: "PK_inv_product_category") @db.VarChar(20)
  CategoryName String    @db.NVarChar(100)
  IsActive     Boolean   @default(true)
  CreatedDate  DateTime? @default(now()) @db.DateTime
  CreatedBy    String?   @db.VarChar(20)
  UpdatedDate  DateTime? @db.DateTime
  UpdatedBy    String?   @db.VarChar(20)

  Products InvProduct[]

  @@map("inv_product_category")
}

model InvProduct {
  ProductCode   String    @id(map: "PK_inv_product") @db.VarChar(15)
  ProductName   String    @db.NVarChar(150)
  CategoryCode  String?   @db.VarChar(20)
  UnitOfMeasure String?   @db.NVarChar(20)
  UnitCost      Decimal   @default(0) @db.Decimal(10, 2)
  UnitPrice     Decimal   @default(0) @db.Decimal(10, 2)
  IsActive      Boolean   @default(true)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  ProductCategory   InvProductCategory?      @relation(fields: [CategoryCode], references: [CategoryCode], map: "FK_inv_product_category", onUpdate: NoAction, onDelete: NoAction)
  MovementDetails   InvStockMovementDetail[]
  SecondhandStocks  InvSecondhandStock[]
  StockCountDetails InvStockCountDetail[]
  PurchaseDetails   InvPurchaseDetail[]
  TransferDetails   InvTransferDetail[]
  IssueDetails      InvIssueDetail[]
  ReturnDetails     InvReturnDetail[]

  @@map("inv_product")
}

// Stock count as its own header+detail document workflow (2026-09-20,
// mirrors trn_request_header/detail) — separate from the shared
// inv_stock_movement ledger table because it needs its own DRAFT -> SUBMITTED
// -> APPROVED states (a fifth ADJUST-only workflow alongside PURCHASE/
// TRANSFER/ISSUE/RETURN would require widening inv_stock_movement.Status's
// CHECK constraint, which is shared by all 5 movement types and would risk
// the simpler DRAFT/CONFIRMED-only types). Approving a count document is what
// actually posts to the ledger: it creates+confirms one ADJUST
// inv_stock_movement per line (delta between counted qty and the live ledger
// balance at approval time) and upserts inv_secondhand_stock — the count
// document itself never stores a running stock balance.
model InvStockCountHeader {
  StockCountHeaderID Int       @id(map: "PK_inv_stock_count_header") @default(autoincrement())
  DocumentNo         String?   @db.VarChar(20)
  WarehouseCode      String    @db.VarChar(10)
  CountDate          DateTime  @db.Date
  Remark             String?   @db.NVarChar(300)
  Status             String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy          String    @db.VarChar(20)
  CreatedDate        DateTime  @default(now()) @db.DateTime
  SubmittedDate      DateTime? @db.DateTime
  ApprovedBy         String?   @db.VarChar(20)
  ApprovedDate       DateTime? @db.DateTime
  RejectedBy         String?   @db.VarChar(20)
  RejectedDate       DateTime? @db.DateTime
  RejectReason       String?   @db.NVarChar(300)
  UpdatedDate        DateTime? @db.DateTime
  UpdatedBy          String?   @db.VarChar(20)

  Warehouse InvWarehouse          @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_stock_count_header_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser               @relation("StockCountHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_stock_count_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?              @relation("StockCountHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_stock_count_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?              @relation("StockCountHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_stock_count_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvStockCountDetail[]

  @@map("inv_stock_count_header")
}

model InvStockCountDetail {
  StockCountDetailID   Int       @id(map: "PK_inv_stock_count_detail") @default(autoincrement())
  StockCountHeaderID   Int
  ProductCode          String    @db.VarChar(15)
  CountedQty           Decimal   @db.Decimal(10, 2)
  CountedSecondHandQty Decimal   @default(0) @db.Decimal(10, 2)
  CreatedDate          DateTime? @default(now()) @db.DateTime
  CreatedBy            String?   @db.VarChar(20)
  UpdatedDate          DateTime? @db.DateTime
  UpdatedBy            String?   @db.VarChar(20)

  Header  InvStockCountHeader @relation(fields: [StockCountHeaderID], references: [StockCountHeaderID], map: "FK_inv_stock_count_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct          @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_stock_count_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([StockCountHeaderID], map: "IX_inv_stock_count_detail_StockCountHeaderID")
  @@map("inv_stock_count_detail")
}

// Purchase as its own header+detail document workflow (2026-09-20), same
// reasoning and shape as InvStockCountHeader/Detail above — approving posts
// one PURCHASE inv_stock_movement covering every line (all lines add to the
// same receiving warehouse, so unlike ADJUST there's no per-line delta to
// compute) and recalculates each line's product UnitCost as a weighted
// average against its current total on-hand qty across all warehouses.
model InvPurchaseHeader {
  PurchaseHeaderID   Int       @id(map: "PK_inv_purchase_header") @default(autoincrement())
  DocumentNo         String?   @db.VarChar(20)
  WarehouseCode      String    @db.VarChar(10)
  SupplierCode       String    @db.VarChar(15)
  SupplierDeliveryNo String?   @db.VarChar(50)
  DeliveryDate       DateTime  @db.Date
  Remark             String?   @db.NVarChar(300)
  Status             String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy          String    @db.VarChar(20)
  CreatedDate        DateTime  @default(now()) @db.DateTime
  SubmittedDate      DateTime? @db.DateTime
  ApprovedBy         String?   @db.VarChar(20)
  ApprovedDate       DateTime? @db.DateTime
  RejectedBy         String?   @db.VarChar(20)
  RejectedDate       DateTime? @db.DateTime
  RejectReason       String?   @db.NVarChar(300)
  UpdatedDate        DateTime? @db.DateTime
  UpdatedBy          String?   @db.VarChar(20)

  Warehouse InvWarehouse        @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_purchase_header_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Supplier  InvSupplier         @relation(fields: [SupplierCode], references: [SupplierCode], map: "FK_inv_purchase_header_supplier", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser             @relation("PurchaseHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_purchase_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?            @relation("PurchaseHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_purchase_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?            @relation("PurchaseHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_purchase_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvPurchaseDetail[]

  @@map("inv_purchase_header")
}

model InvPurchaseDetail {
  PurchaseDetailID Int       @id(map: "PK_inv_purchase_detail") @default(autoincrement())
  PurchaseHeaderID Int
  ProductCode      String    @db.VarChar(15)
  Qty              Decimal   @db.Decimal(10, 2)
  UnitPrice        Decimal   @db.Decimal(10, 2)
  Amount           Decimal   @db.Decimal(12, 2)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  Header  InvPurchaseHeader @relation(fields: [PurchaseHeaderID], references: [PurchaseHeaderID], map: "FK_inv_purchase_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct        @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_purchase_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([PurchaseHeaderID], map: "IX_inv_purchase_detail_PurchaseHeaderID")
  @@map("inv_purchase_detail")
}

// Transfer as its own header+detail workflow (2026-09-20), same shape as
// Purchase/StockCount — approving posts one TRANSFER inv_stock_movement
// covering every line (subtract from source, add to target, same as the
// existing shared-ledger TRANSFER semantics) and moves each line's
// SecondHandQty directly between the two warehouses' inv_secondhand_stock
// rows (decrement source, upsert target) — sufficiency-checked on both.
model InvTransferHeader {
  TransferHeaderID    Int       @id(map: "PK_inv_transfer_header") @default(autoincrement())
  DocumentNo          String?   @db.VarChar(20)
  SourceWarehouseCode String    @db.VarChar(10)
  TargetWarehouseCode String    @db.VarChar(10)
  DeliveryNo          String?   @db.VarChar(50)
  DeliveryDate        DateTime  @db.Date
  Remark              String?   @db.NVarChar(300)
  Status              String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy           String    @db.VarChar(20)
  CreatedDate         DateTime  @default(now()) @db.DateTime
  SubmittedDate       DateTime? @db.DateTime
  ApprovedBy          String?   @db.VarChar(20)
  ApprovedDate        DateTime? @db.DateTime
  RejectedBy          String?   @db.VarChar(20)
  RejectedDate        DateTime? @db.DateTime
  RejectReason        String?   @db.NVarChar(300)
  UpdatedDate         DateTime? @db.DateTime
  UpdatedBy           String?   @db.VarChar(20)

  SourceWarehouse InvWarehouse        @relation("TransferHeaderSourceWarehouse", fields: [SourceWarehouseCode], references: [WarehouseCode], map: "FK_inv_transfer_header_source_warehouse", onUpdate: NoAction, onDelete: NoAction)
  TargetWarehouse InvWarehouse        @relation("TransferHeaderTargetWarehouse", fields: [TargetWarehouseCode], references: [WarehouseCode], map: "FK_inv_transfer_header_target_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Creator         SysUser             @relation("TransferHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_transfer_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver        SysUser?            @relation("TransferHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_transfer_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter        SysUser?            @relation("TransferHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_transfer_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details         InvTransferDetail[]

  @@map("inv_transfer_header")
}

model InvTransferDetail {
  TransferDetailID Int       @id(map: "PK_inv_transfer_detail") @default(autoincrement())
  TransferHeaderID Int
  ProductCode      String    @db.VarChar(15)
  Qty              Decimal   @db.Decimal(10, 2)
  SecondHandQty    Decimal   @default(0) @db.Decimal(10, 2)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  Header  InvTransferHeader @relation(fields: [TransferHeaderID], references: [TransferHeaderID], map: "FK_inv_transfer_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct        @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_transfer_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([TransferHeaderID], map: "IX_inv_transfer_detail_TransferHeaderID")
  @@map("inv_transfer_detail")
}

// Issue as its own header+detail workflow (2026-09-20) — each line is either
// a regular product (auto-priced from inv_product.UnitPrice) or a
// secondhand item (manually priced), and can be flagged "สวัสดิการ" (welfare
// / free — still leaves the warehouse, but excluded from the amount owed).
// Approving posts regular lines as one ISSUE inv_stock_movement, decrements
// inv_secondhand_stock directly for secondhand lines, and merges the
// non-welfare total (net of cash received) into the employee's single
// running OPEN "UNIFORM" inv_employee_debt row (creating it if none exists)
// — per the user's explicit choice, not a new debt row per document.
model InvIssueHeader {
  IssueHeaderID   Int       @id(map: "PK_inv_issue_header") @default(autoincrement())
  DocumentNo      String?   @db.VarChar(20)
  WarehouseCode   String    @db.VarChar(10)
  DeliveryNo      String?   @db.VarChar(50)
  DeliveryDate    DateTime  @db.Date
  EmpCode         String    @db.VarChar(15)
  CashReceived    Decimal   @default(0) @db.Decimal(12, 2)
  DeductPerPeriod Decimal?  @db.Decimal(12, 2)
  Remark          String?   @db.NVarChar(300)
  Status          String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy       String    @db.VarChar(20)
  CreatedDate     DateTime  @default(now()) @db.DateTime
  SubmittedDate   DateTime? @db.DateTime
  ApprovedBy      String?   @db.VarChar(20)
  ApprovedDate    DateTime? @db.DateTime
  RejectedBy      String?   @db.VarChar(20)
  RejectedDate    DateTime? @db.DateTime
  RejectReason    String?   @db.NVarChar(300)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  Warehouse InvWarehouse     @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_issue_header_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Employee  MstEmployee      @relation(fields: [EmpCode], references: [EmpCode], map: "FK_inv_issue_header_employee", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser          @relation("IssueHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_issue_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?         @relation("IssueHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_issue_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?         @relation("IssueHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_issue_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvIssueDetail[]

  @@map("inv_issue_header")
}

model InvIssueDetail {
  IssueDetailID Int       @id(map: "PK_inv_issue_detail") @default(autoincrement())
  IssueHeaderID Int
  ProductCode   String    @db.VarChar(15)
  IsSecondHand  Boolean   @default(false)
  Qty           Decimal   @db.Decimal(10, 2)
  UnitPrice     Decimal   @db.Decimal(10, 2)
  Amount        Decimal   @db.Decimal(12, 2)
  IsWelfare     Boolean   @default(false)
  CreatedDate   DateTime? @default(now()) @db.DateTime
  CreatedBy     String?   @db.VarChar(20)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(20)

  Header  InvIssueHeader @relation(fields: [IssueHeaderID], references: [IssueHeaderID], map: "FK_inv_issue_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct     @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_issue_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([IssueHeaderID], map: "IX_inv_issue_detail_IssueHeaderID")
  @@map("inv_issue_detail")
}

// Return as its own header+detail workflow (2026-09-20) — mirrors Issue's
// structure. Approving posts regular lines as one RETURN inv_stock_movement,
// increments inv_secondhand_stock directly for secondhand lines, and
// applies the total as a payment against the employee's OPEN "UNIFORM" debt
// (same apply-to-RemainingAmount mechanic the old ISSUE/RETURN confirm flow
// already used for movement-linked debts) — if none is open, there's
// nothing to reduce and the debt step is skipped silently.
model InvReturnHeader {
  ReturnHeaderID Int       @id(map: "PK_inv_return_header") @default(autoincrement())
  DocumentNo     String?   @db.VarChar(20)
  WarehouseCode  String    @db.VarChar(10)
  DeliveryNo     String?   @db.VarChar(50)
  DeliveryDate   DateTime  @db.Date
  EmpCode        String    @db.VarChar(15)
  Remark         String?   @db.NVarChar(300)
  Status         String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy      String    @db.VarChar(20)
  CreatedDate    DateTime  @default(now()) @db.DateTime
  SubmittedDate  DateTime? @db.DateTime
  ApprovedBy     String?   @db.VarChar(20)
  ApprovedDate   DateTime? @db.DateTime
  RejectedBy     String?   @db.VarChar(20)
  RejectedDate   DateTime? @db.DateTime
  RejectReason   String?   @db.NVarChar(300)
  UpdatedDate    DateTime? @db.DateTime
  UpdatedBy      String?   @db.VarChar(20)

  Warehouse InvWarehouse      @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_return_header_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Employee  MstEmployee       @relation(fields: [EmpCode], references: [EmpCode], map: "FK_inv_return_header_employee", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser           @relation("ReturnHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_return_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?          @relation("ReturnHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_return_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?          @relation("ReturnHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_return_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvReturnDetail[]

  @@map("inv_return_header")
}

model InvReturnDetail {
  ReturnDetailID Int       @id(map: "PK_inv_return_detail") @default(autoincrement())
  ReturnHeaderID Int
  ProductCode    String    @db.VarChar(15)
  IsSecondHand   Boolean   @default(false)
  Qty            Decimal   @db.Decimal(10, 2)
  UnitPrice      Decimal   @db.Decimal(10, 2)
  Amount         Decimal   @db.Decimal(12, 2)
  CreatedDate    DateTime? @default(now()) @db.DateTime
  CreatedBy      String?   @db.VarChar(20)
  UpdatedDate    DateTime? @db.DateTime
  UpdatedBy      String?   @db.VarChar(20)

  Header  InvReturnHeader @relation(fields: [ReturnHeaderID], references: [ReturnHeaderID], map: "FK_inv_return_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct      @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_return_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([ReturnHeaderID], map: "IX_inv_return_detail_ReturnHeaderID")
  @@map("inv_return_detail")
}

model InvSecondhandStock {
  SecondhandStockID Int       @id(map: "PK_inv_secondhand_stock") @default(autoincrement())
  WarehouseCode     String    @db.VarChar(10)
  ProductCode       String    @db.VarChar(15)
  Qty               Decimal   @default(0) @db.Decimal(10, 2)
  CreatedDate       DateTime? @default(now()) @db.DateTime
  CreatedBy         String?   @db.VarChar(20)
  UpdatedDate       DateTime? @db.DateTime
  UpdatedBy         String?   @db.VarChar(20)

  Warehouse InvWarehouse @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_secondhand_stock_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Product   InvProduct   @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_secondhand_stock_product", onUpdate: NoAction, onDelete: NoAction)

  @@unique([WarehouseCode, ProductCode], map: "UQ_inv_secondhand_stock_warehouse_product")
  @@map("inv_secondhand_stock")
}

model InvStockMovement {
  MovementID          Int       @id(map: "PK_inv_stock_movement") @default(autoincrement())
  MovementType        String    @db.VarChar(15) // CHECK: ADJUST | PURCHASE | TRANSFER | ISSUE | RETURN
  WarehouseCode       String    @db.VarChar(10)
  TargetWarehouseCode String?   @db.VarChar(10)
  SupplierCode        String?   @db.VarChar(15)
  EmpCode             String?   @db.VarChar(15)
  MovementDate        DateTime  @db.Date
  Status              String    @default("DRAFT") @db.VarChar(10) // CHECK: DRAFT | CONFIRMED
  CreatedBy           String    @db.VarChar(20)
  CreatedDate         DateTime  @default(now()) @db.DateTime
  UpdatedDate         DateTime? @db.DateTime
  UpdatedBy           String?   @db.VarChar(20)

  Warehouse       InvWarehouse  @relation("MovementSourceWarehouse", fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_stock_movement_warehouse", onUpdate: NoAction, onDelete: NoAction)
  TargetWarehouse InvWarehouse? @relation("MovementTargetWarehouse", fields: [TargetWarehouseCode], references: [WarehouseCode], map: "FK_inv_stock_movement_target_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Supplier        InvSupplier?  @relation(fields: [SupplierCode], references: [SupplierCode], map: "FK_inv_stock_movement_supplier", onUpdate: NoAction, onDelete: NoAction)
  Employee        MstEmployee?  @relation(fields: [EmpCode], references: [EmpCode], map: "FK_inv_stock_movement_employee", onUpdate: NoAction, onDelete: NoAction)
  Creator         SysUser       @relation(fields: [CreatedBy], references: [UserID], map: "FK_inv_stock_movement_sys_user", onUpdate: NoAction, onDelete: NoAction)

  Details       InvStockMovementDetail[]
  EmployeeDebts InvEmployeeDebt[]

  @@map("inv_stock_movement")
}

model InvStockMovementDetail {
  DetailID    Int       @id(map: "PK_inv_stock_movement_detail") @default(autoincrement())
  MovementID  Int
  ProductCode String    @db.VarChar(15)
  Qty         Decimal   @db.Decimal(10, 2)
  UnitPrice   Decimal   @db.Decimal(10, 2)
  Amount      Decimal   @db.Decimal(12, 2)
  CreatedDate DateTime? @default(now()) @db.DateTime
  CreatedBy   String?   @db.VarChar(20)
  UpdatedDate DateTime? @db.DateTime
  UpdatedBy   String?   @db.VarChar(20)

  Movement InvStockMovement @relation(fields: [MovementID], references: [MovementID], map: "FK_inv_stock_movement_detail_movement", onUpdate: NoAction, onDelete: NoAction)
  Product  InvProduct       @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_stock_movement_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([MovementID], map: "IX_inv_stock_movement_detail_MovementID")
  @@map("inv_stock_movement_detail")
}

model InvEmployeeDebt {
  DebtID          Int       @id(map: "PK_inv_employee_debt") @default(autoincrement())
  EmpCode         String    @db.VarChar(15)
  // Nullable as of 2026-09-19 — originally every debt row came from an
  // inventory ISSUE confirm. Now "รายการหักต่องวด" on the employee page can
  // also create a debt directly (loans, advances, etc. per
  // ref_deduction_type.IsInstallment) with no underlying stock movement, so
  // exactly one of MovementID / DeductionCode is set depending on origin —
  // enforced in application code, not a DB CHECK (no such constraint exists
  // in the approved DDL for this table to extend).
  MovementID      Int?
  DeductionCode   String?   @db.VarChar(10)
  // Set only for debts created by approving a Request (trn_request_header) —
  // lets the "รายการหักต่องวด" tab show the source document's เลขที่เอกสาร/
  // วันที่อนุมัติ. Null for MovementID-origin debts and for debts created
  // directly on this tab with no underlying document.
  RequestHeaderID Int?
  Description     String?   @db.NVarChar(200) // free-text note for manually-created (DeductionCode-origin) debts
  TotalAmount     Decimal   @default(0) @db.Decimal(12, 2)
  PaidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  RemainingAmount Decimal   @default(0) @db.Decimal(12, 2)
  DeductPerPeriod Decimal?  @db.Decimal(12, 2) // "ยอดหักต่องวด" — tracked here only, not yet auto-applied by Payroll Calculate
  Status          String    @default("OPEN") @db.VarChar(10) // CHECK: OPEN | CLOSED
  CreatedDate     DateTime? @default(now()) @db.DateTime
  CreatedBy       String?   @db.VarChar(20)
  UpdatedDate     DateTime? @db.DateTime
  UpdatedBy       String?   @db.VarChar(20)

  Employee      MstEmployee       @relation(fields: [EmpCode], references: [EmpCode], map: "FK_inv_employee_debt_employee", onUpdate: NoAction, onDelete: NoAction)
  Movement      InvStockMovement? @relation(fields: [MovementID], references: [MovementID], map: "FK_inv_employee_debt_movement", onUpdate: NoAction, onDelete: NoAction)
  DeductionType RefDeductionType? @relation(fields: [DeductionCode], references: [DeductionCode], map: "FK_inv_employee_debt_deduction_type", onUpdate: NoAction, onDelete: NoAction)
  RequestHeader TrnRequestHeader? @relation(fields: [RequestHeaderID], references: [RequestHeaderID], map: "FK_inv_employee_debt_request_header", onUpdate: NoAction, onDelete: NoAction)

  @@map("inv_employee_debt")
}

// ============================================================
// โมดูล 9: ใบลงเวลาปฏิบัติงานประจำเดือน (Worksheet)
