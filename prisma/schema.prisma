  Creator   SysUser           @relation("ReturnHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_return_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?          @relation("ReturnHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_return_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?          @relation("ReturnHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_return_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvReturnDetail[]

  @@map("inv_return_header")
}

