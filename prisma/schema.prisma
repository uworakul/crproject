// Stock count as its own header+detail document workflow (2026-09-20,
// mirrors trn_request_header/detail) — separate from the shared
// inv_stock_movement ledger table because it needs its own DRAFT -> SUBMITTED
// -> APPROVED states (a fifth ADJUST-only workflow alongside PURCHASE/
// TRANSFER/ISSUE/RETURN would require widening inv_stock_movement.Status's
// CHECK constraint, which is shared by all 5 movement types and would risk
// the simpler DRAFT/CONFIRMED-only types). Approving a count document is what
// actually posts to the ledger: it creates+confirms one ADJUST
// inv_stock_movement per line (delta between counted qty and the live ledger
// balance at approval time) and upserts inv_secondhand_stock — the count
// document itself never stores a running stock balance.
model InvStockCountHeader {
  StockCountHeaderID Int       @id(map: "PK_inv_stock_count_header") @default(autoincrement())
  DocumentNo         String?   @db.VarChar(20)
  WarehouseCode      String    @db.VarChar(10)
  CountDate          DateTime  @db.Date
  Remark             String?   @db.NVarChar(300)
  Status             String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy          String    @db.VarChar(20)
  CreatedDate        DateTime  @default(now()) @db.DateTime
  SubmittedDate      DateTime? @db.DateTime
  ApprovedBy         String?   @db.VarChar(20)
  ApprovedDate       DateTime? @db.DateTime
  RejectedBy         String?   @db.VarChar(20)
  RejectedDate       DateTime? @db.DateTime
  RejectReason       String?   @db.NVarChar(300)
  UpdatedDate        DateTime? @db.DateTime
  UpdatedBy          String?   @db.VarChar(20)

  Warehouse InvWarehouse          @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_stock_count_header_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser               @relation("StockCountHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_stock_count_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?              @relation("StockCountHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_stock_count_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?              @relation("StockCountHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_stock_count_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvStockCountDetail[]

  @@map("inv_stock_count_header")
}

model InvStockCountDetail {
  StockCountDetailID   Int       @id(map: "PK_inv_stock_count_detail") @default(autoincrement())
  StockCountHeaderID   Int
  ProductCode          String    @db.VarChar(15)
  CountedQty           Decimal   @db.Decimal(10, 2)
  CountedSecondHandQty Decimal   @default(0) @db.Decimal(10, 2)
  CreatedDate          DateTime? @default(now()) @db.DateTime
  CreatedBy            String?   @db.VarChar(20)
  UpdatedDate          DateTime? @db.DateTime
  UpdatedBy            String?   @db.VarChar(20)

  Header  InvStockCountHeader @relation(fields: [StockCountHeaderID], references: [StockCountHeaderID], map: "FK_inv_stock_count_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct          @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_stock_count_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([StockCountHeaderID], map: "IX_inv_stock_count_detail_StockCountHeaderID")
  @@map("inv_stock_count_detail")
}

// Purchase as its own header+detail document workflow (2026-09-20), same
// reasoning and shape as InvStockCountHeader/Detail above — approving posts
// one PURCHASE inv_stock_movement covering every line (all lines add to the
// same receiving warehouse, so unlike ADJUST there's no per-line delta to
// compute) and recalculates each line's product UnitCost as a weighted
// average against its current total on-hand qty across all warehouses.
model InvPurchaseHeader {
  PurchaseHeaderID   Int       @id(map: "PK_inv_purchase_header") @default(autoincrement())
  DocumentNo         String?   @db.VarChar(20)
  WarehouseCode      String    @db.VarChar(10)
  SupplierCode       String    @db.VarChar(15)
  SupplierDeliveryNo String?   @db.VarChar(50)
  DeliveryDate       DateTime  @db.Date
  Remark             String?   @db.NVarChar(300)
  Status             String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy          String    @db.VarChar(20)
  CreatedDate        DateTime  @default(now()) @db.DateTime
  SubmittedDate      DateTime? @db.DateTime
  ApprovedBy         String?   @db.VarChar(20)
  ApprovedDate       DateTime? @db.DateTime
  RejectedBy         String?   @db.VarChar(20)
  RejectedDate       DateTime? @db.DateTime
  RejectReason       String?   @db.NVarChar(300)
  UpdatedDate        DateTime? @db.DateTime
  UpdatedBy          String?   @db.VarChar(20)

  Warehouse InvWarehouse        @relation(fields: [WarehouseCode], references: [WarehouseCode], map: "FK_inv_purchase_header_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Supplier  InvSupplier         @relation(fields: [SupplierCode], references: [SupplierCode], map: "FK_inv_purchase_header_supplier", onUpdate: NoAction, onDelete: NoAction)
  Creator   SysUser             @relation("PurchaseHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_purchase_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver  SysUser?            @relation("PurchaseHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_purchase_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter  SysUser?            @relation("PurchaseHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_purchase_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details   InvPurchaseDetail[]

  @@map("inv_purchase_header")
}

model InvPurchaseDetail {
  PurchaseDetailID Int       @id(map: "PK_inv_purchase_detail") @default(autoincrement())
  PurchaseHeaderID Int
  ProductCode      String    @db.VarChar(15)
  Qty              Decimal   @db.Decimal(10, 2)
  UnitPrice        Decimal   @db.Decimal(10, 2)
  Amount           Decimal   @db.Decimal(12, 2)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  Header  InvPurchaseHeader @relation(fields: [PurchaseHeaderID], references: [PurchaseHeaderID], map: "FK_inv_purchase_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct        @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_purchase_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([PurchaseHeaderID], map: "IX_inv_purchase_detail_PurchaseHeaderID")
  @@map("inv_purchase_detail")
}

// Transfer as its own header+detail workflow (2026-09-20), same shape as
// Purchase/StockCount — approving posts one TRANSFER inv_stock_movement
// covering every line (subtract from source, add to target, same as the
// existing shared-ledger TRANSFER semantics) and moves each line's
// SecondHandQty directly between the two warehouses' inv_secondhand_stock
// rows (decrement source, upsert target) — sufficiency-checked on both.
model InvTransferHeader {
  TransferHeaderID    Int       @id(map: "PK_inv_transfer_header") @default(autoincrement())
  DocumentNo          String?   @db.VarChar(20)
  SourceWarehouseCode String    @db.VarChar(10)
  TargetWarehouseCode String    @db.VarChar(10)
  DeliveryNo          String?   @db.VarChar(50)
  DeliveryDate        DateTime  @db.Date
  Remark              String?   @db.NVarChar(300)
  Status              String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
  CreatedBy           String    @db.VarChar(20)
  CreatedDate         DateTime  @default(now()) @db.DateTime
  SubmittedDate       DateTime? @db.DateTime
  ApprovedBy          String?   @db.VarChar(20)
  ApprovedDate        DateTime? @db.DateTime
  RejectedBy          String?   @db.VarChar(20)
  RejectedDate        DateTime? @db.DateTime
  RejectReason        String?   @db.NVarChar(300)
  UpdatedDate         DateTime? @db.DateTime
  UpdatedBy           String?   @db.VarChar(20)

  SourceWarehouse InvWarehouse        @relation("TransferHeaderSourceWarehouse", fields: [SourceWarehouseCode], references: [WarehouseCode], map: "FK_inv_transfer_header_source_warehouse", onUpdate: NoAction, onDelete: NoAction)
  TargetWarehouse InvWarehouse        @relation("TransferHeaderTargetWarehouse", fields: [TargetWarehouseCode], references: [WarehouseCode], map: "FK_inv_transfer_header_target_warehouse", onUpdate: NoAction, onDelete: NoAction)
  Creator         SysUser             @relation("TransferHeaderCreatedBy", fields: [CreatedBy], references: [UserID], map: "FK_inv_transfer_header_sys_user_created", onUpdate: NoAction, onDelete: NoAction)
  Approver        SysUser?            @relation("TransferHeaderApprovedBy", fields: [ApprovedBy], references: [UserID], map: "FK_inv_transfer_header_sys_user_approved", onUpdate: NoAction, onDelete: NoAction)
  Rejecter        SysUser?            @relation("TransferHeaderRejectedBy", fields: [RejectedBy], references: [UserID], map: "FK_inv_transfer_header_sys_user_rejected", onUpdate: NoAction, onDelete: NoAction)
  Details         InvTransferDetail[]

  @@map("inv_transfer_header")
}

model InvTransferDetail {
  TransferDetailID Int       @id(map: "PK_inv_transfer_detail") @default(autoincrement())
  TransferHeaderID Int
  ProductCode      String    @db.VarChar(15)
  Qty              Decimal   @db.Decimal(10, 2)
  SecondHandQty    Decimal   @default(0) @db.Decimal(10, 2)
  CreatedDate      DateTime? @default(now()) @db.DateTime
  CreatedBy        String?   @db.VarChar(20)
  UpdatedDate      DateTime? @db.DateTime
  UpdatedBy        String?   @db.VarChar(20)

  Header  InvTransferHeader @relation(fields: [TransferHeaderID], references: [TransferHeaderID], map: "FK_inv_transfer_detail_header", onUpdate: NoAction, onDelete: NoAction)
  Product InvProduct        @relation(fields: [ProductCode], references: [ProductCode], map: "FK_inv_transfer_detail_product", onUpdate: NoAction, onDelete: NoAction)

  @@index([TransferHeaderID], map: "IX_inv_transfer_detail_TransferHeaderID")
  @@map("inv_transfer_detail")
}

// Issue as its own header+detail workflow (2026-09-20) — each line is either
// a regular product (auto-priced from inv_product.UnitPrice) or a
// secondhand item (manually priced), and can be flagged "สวัสดิการ" (welfare
// / free — still leaves the warehouse, but excluded from the amount owed).
// Approving posts regular lines as one ISSUE inv_stock_movement, decrements
// inv_secondhand_stock directly for secondhand lines, and merges the
// non-welfare total (net of cash received) into the employee's single
// running OPEN "UNIFORM" inv_employee_debt row (creating it if none exists)
// — per the user's explicit choice, not a new debt row per document.
model InvIssueHeader {
  IssueHeaderID   Int       @id(map: "PK_inv_issue_header") @default(autoincrement())
  DocumentNo      String?   @db.VarChar(20)
  WarehouseCode   String    @db.VarChar(10)
  DeliveryNo      String?   @db.VarChar(50)
  DeliveryDate    DateTime  @db.Date
  EmpCode         String    @db.VarChar(15)
  CashReceived    Decimal   @default(0) @db.Decimal(12, 2)
  DeductPerPeriod Decimal?  @db.Decimal(12, 2)
  Remark          String?   @db.NVarChar(300)
  Status          String    @default("DRAFT") @db.VarChar(15) // CHECK: DRAFT | SUBMITTED | APPROVED
